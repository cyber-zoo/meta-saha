#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd -P)"
# shellcheck source=saha-lib
. "$SCRIPT_DIR/saha-lib"

usage() {
  cat <<'USAGE'
Usage: scripts/saha-build <target>

Build saha-image-robot for a supported target inside Docker.
Jetson targets support ROS 2 Jazzy and Lyrical. IQ-9075 and RDK X5 are pinned
to ROS 2 Jazzy; IQ-9075 uses the standard Qualcomm EVK graph. Set
SAHA_HOMEASSISTANT=0 to omit the optional Docker and preloaded Home Assistant
image on Jetson and IQ-9075. RDK X5 requires SAHA_META_D_ROBOTICS_DIR to point
to its BSP layer.
Run scripts/saha-targets to list targets.
USAGE
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

if [ $# -ne 1 ]; then
  usage >&2
  exit 2
fi

TARGET=$1
saha_require_target "$TARGET" >/dev/null
KAS_CONFIG="$(saha_kas_config_for_target "$TARGET")"
saha_validate_target_inputs "$TARGET"
ROOT_DIR="$(saha_repo_root)"
saha_prepare_docker_env "$ROOT_DIR"
saha_apply_build_tuning_defaults

saha_build_builder_image "$ROOT_DIR"
saha_run_docker "$ROOT_DIR" "$TARGET" 0 kas build "$KAS_CONFIG"
