#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd -P)"
# shellcheck source=saha-lib
. "$SCRIPT_DIR/saha-lib"

usage() {
  cat <<'USAGE'
Usage: scripts/saha-shell <target> [-c <command>]

Open a kas shell for a supported target inside Docker.
With -c, run a non-interactive command inside the kas shell. Jetson targets
support ROS 2 Jazzy and Lyrical; IQ-9075 and RDK X5 are pinned to Jazzy. The
optional Home Assistant image is available on Jetson and IQ-9075. RDK X5
requires SAHA_META_D_ROBOTICS_DIR.
Run scripts/saha-targets to list targets.
Radxa ZERO 3W and Orange Pi Zero 3W use the ROS-free Microduck graph.
Microduck shells reuse the current build lock; if none exists, they resolve
the latest stable daemon release. SAHA_MICRODUCK_RELEASE or
SAHA_MICRODUCK_RELEASE_LOCK overrides that selection.
USAGE
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

if [ $# -ne 1 ] && [ $# -ne 3 ]; then
  usage >&2
  exit 2
fi

TARGET=$1
INTERACTIVE=1
COMMAND_ARGS=()
if [ $# -eq 3 ]; then
  if [ "$2" != "-c" ]; then
    usage >&2
    exit 2
  fi
  INTERACTIVE=0
  COMMAND_ARGS=(-c "$3")
fi

saha_require_target "$TARGET" >/dev/null
KAS_CONFIG="$(saha_kas_config_for_target "$TARGET")"
saha_validate_target_inputs "$TARGET"
ROOT_DIR="$(saha_repo_root)"
saha_prepare_docker_env "$ROOT_DIR"
saha_apply_build_tuning_defaults
saha_prepare_microduck_release "$ROOT_DIR" "$TARGET" 1

saha_build_builder_image "$ROOT_DIR"
saha_run_docker "$ROOT_DIR" "$TARGET" "$INTERACTIVE" kas shell "$KAS_CONFIG" "${COMMAND_ARGS[@]}"
